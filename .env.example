# The public site and admin app connect directly to Supabase using the
# project URL + anon key, which are already embedded in supabase-client.js
# (the anon key is safe to expose publicly; access is enforced by Postgres
# Row Level Security).
#
# PORT is the only thing server.js reads from the environment.
PORT=3000

# Online payments are taken as manual QR transfers: the customer pays to one of
# the studio's GCash / GoTyme / BPI QRs (assets/payment_qr/, listed in
# payment-qr.js), uploads the receipt into the private `payment-receipts`
# bucket, and staff approve it from the admin Payments tab. That needs no keys
# or secrets at all.
#
# The PayMongo hosted-checkout integration is still wired up but switched off
# (app_settings.paymongo_enabled = false). To bring it back, flip that setting
# in Admin > Settings AND set these as Edge Function secrets in the Supabase
# dashboard (Project Settings > Edge Functions > Secrets):
#   PAYMONGO_SECRET_KEY=sk_live_or_test_...
#   PAYMONGO_WEBHOOK_SECRET=whsk_...
# Point PayMongo's webhook at:
#   https://poxgdnisortpetxqirwg.supabase.co/functions/v1/paymongo-webhook

# Transactional email (booking confirmations, receipts, cancellations) is sent
# from the Edge Functions through Resend. Set these as Edge Function secrets in
# the Supabase dashboard (Project Settings > Edge Functions > Secrets), or push
# a local .env with:
#   npx supabase secrets set --env-file .env --project-ref poxgdnisortpetxqirwg
#
#   RESEND_API_KEY=re_...          required; without it every send is skipped
#                                  (logged as a warning) and the booking,
#                                  refund or cancellation carries on regardless
#   EMAIL_FROM=GGS Studio <bookings@your-verified-domain.com>
#                                  optional but effectively required in
#                                  production: the default sender only reaches
#                                  addresses Resend already allows. Use a
#                                  domain verified in the Resend dashboard.
#   EMAIL_BCC=studio@your-domain.com
#                                  optional; copies the studio on every
#                                  customer email.

