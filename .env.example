# The public site and the dashboard connect directly to Supabase using the
# project URL + anon key, which are already embedded in js/supabase-client.js
# (the anon key is safe to expose publicly; access is enforced by Postgres
# Row Level Security).
#
# PORT is the only thing server.js reads from the environment.
PORT=3000

# Online payments are manual transfers: the customer pays into one of the
# accounts set up in Dashboard > Setup > Payment methods (QR images upload
# there), sends the receipt, and staff approve it on the Payments page. That
# needs no keys at all.
#
# The PayMongo hosted checkout is still wired up but switched off. To bring it
# back, switch it on in Dashboard > Setup > Booking rules AND set:
#   PAYMONGO_SECRET_KEY=sk_live_or_test_...
#   PAYMONGO_WEBHOOK_SECRET=whsk_...

# Everything below is an Edge Function secret (Supabase dashboard > Project
# Settings > Edge Functions > Secrets), or push a local .env with:
#   npx supabase secrets set --env-file .env --project-ref poxgdnisortpetxqirwg
#
# Email (Resend)
#   RESEND_API_KEY=re_...       required; full access if the shared inbox reads
#                               received mail. Without it every send is skipped
#                               and the dashboard shows a "not configured" notice.
#   EMAIL_FROM=GGS Studio <bookings@ggsstudio.site>
#   MAIL_DOMAIN=ggsstudio.site  where bookings@, contact@ and promotions@ live
#   EMAIL_BCC=                  optional; copies the studio on customer emails
#   STAFF_NOTIFY_EMAIL=         optional; overrides Dashboard > Setup > Contacts >
#                               Forward to (booking alerts and copies of received mail)
#   SITE_URL=https://www.ggsstudio.site   used in links inside emails
#
# Shared inbox (Dashboard > Messages > Inbox)
#   Receiving is on for MAIL_DOMAIN in Resend and the email.received webhook
#   points at https://poxgdnisortpetxqirwg.supabase.co/functions/v1/resend-webhook.
#   Its signing secret is stored in app_secrets.resend_webhook_secret (or set
#   RESEND_WEBHOOK_SECRET). The domain also needs this DNS record:
#       MX  @  inbound-smtp.ap-northeast-1.amazonaws.com  priority 10
#   Mail to contact@ / bookings@ lands in the inbox and a copy is forwarded to
#   the addresses in Setup > Contacts > Forward to. Set INBOX_ENABLED=false to
#   send replies to the contact email instead of the inbox.
#
# Optional
#   LINK_SECRET=                overrides the signing secret for booking and
#                               unsubscribe links (otherwise app_secrets.link_secret)
#   LOGO_URL=                   overrides the email masthead image
#
# Background jobs (review emails, ID photo retention) run every 10 minutes via
# pg_cron calling the `cron` function with app_secrets.cron_secret. No setup.
